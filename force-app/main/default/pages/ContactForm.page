<apex:page sidebar="false" showHeader="false" standardStylesheets="false" controller="ContactFormController">
    <html>
        <head>
            <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert/2.1.2/sweetalert.min.js" integrity="sha512-AA1Bzp5Q0K1KanKKmvN/4d3IRKVlv9PYgwFPvm32nPO6QS8yH1HO7LbgB1pgiOxPtfeg5zEn2ba64MUcqJx6CA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" />
                <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
            <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.6.9/angular.min.js" crossorigin="anonymous"></script>

            <style>
                /* Global styles */
                html, body {
                    background-color: #f3f4f6;
                    font-family: 'Dosis', sans-serif;
                    margin: 0;
                    padding: 0;
                }
            
                /* Card animation */
                .card {
                    background-color: #fff;
                    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
                    border-radius: 10px;
                    margin: 20px auto;
                    width: 95%;
                    padding: 20px;
                    animation: fadeIn 1.2s ease-in-out;
                }
            
                @keyframes fadeIn {
                    from {
                        opacity: 0;
                        transform: translateY(-20px);
                    }
                    to {
                        opacity: 1;
                        transform: translateY(0);
                    }
                }
            
                /* Header animation */
                .header h3 {
                    font-size: 24px;
                    color: #4f46e5;
                    text-align: center;
                    margin-bottom: 20px;
                    animation: popIn 1.5s ease-in-out;
                }
            
                @keyframes popIn {
                    0% {
                        opacity: 0;
                        transform: scale(0.8);
                    }
                    100% {
                        opacity: 1;
                        transform: scale(1);
                    }
                }
            
                /* Input field animations */
                .form-control {
                    border: 1px solid #cbd5e1;
                    border-radius: 5px;
                    padding: 10px;
                    font-size: 14px;
                    transition: all 0.3s ease;
                    width: 100%;
                }
            
                .form-control:focus {
                    border-color: #4f46e5;
                    box-shadow: 0 0 10px rgba(79, 70, 229, 0.4);
                    transform: scale(1.02);
                }
            
                /* Button animation */
                .btn-primary {
                    background-color: #4f46e5;
                    border: none;
                    padding: 10px 20px;
                    border-radius: 5px;
                    font-size: 16px;
                    transition: all 0.3s ease;
                    width: 100%;
                }
            
                .btn-primary:hover {
                    background-color: #4338ca;
                    transform: translateY(-3px);
                    box-shadow: 0 8px 15px rgba(79, 70, 229, 0.3);
                }
            
                /* Section title animation */
                .section-title {
                    font-size: 18px;
                    font-weight: bold;
                    color: #555;
                    background: #e2e8f0;
                    padding: 8px 12px;
                    border-radius: 5px;
                    margin-bottom: 20px;
                    text-align: center;
                    animation: slideIn 1s ease-in-out;
                }
            
                @keyframes slideIn {
                    from {
                        opacity: 0;
                        transform: translateX(-30px);
                    }
                    to {
                        opacity: 1;
                        transform: translateX(0);
                    }
                }
            
                /* Hover effect on labels */
                .form-label {
                    font-weight: bold;
                    color: #333;
                    position: relative;
                }
            
                .form-label:hover {
                    color: #4f46e5;
                }
            
                .form-label .asterisk {
                    color: red;
                    margin-left: 2px;
                }
            
                /* Responsive adjustments */
                @media (min-width: 768px) {
                    .card {
                        width: 80%;
                    }
            
                    .form-inline {
                        display: flex;
                        gap: 20px;
                    }
                }
            </style>
            

            </head>
            <body id="body-pd" ng-app="myApp" ng-controller="myCtrl">
            <script>
                
                var leadObj;
                leadObj = {
                    "Id" : 'ASDFGH',
                    "firstName" : '',
                    "lastName" : '',
                    "email" : '',
                    "phone" : '',
                    "city" : '',
                    "state" : '',
                    "pincode" : ''}
                var app = angular.module('myApp', [])
                .controller('myCtrl', function ($scope) {
                    debugger;
                    $scope.data = leadObj;
                    $scope.leadId = leadObj.Id;
                    $scope.states = [
                    "Andhra Pradesh", "Arunachal Pradesh", "Assam", "Bihar", "Chhattisgarh", "Goa", "Gujarat",
                    "Haryana", "Himachal Pradesh", "Jharkhand", "Karnataka", "Kerala", "Madhya Pradesh",
                    "Maharashtra", "Manipur", "Meghalaya", "Mizoram", "Nagaland", "Odisha", "Punjab",
                    "Rajasthan", "Sikkim", "Tamil Nadu", "Telangana", "Tripura", "Uttar Pradesh",
                    "Uttarakhand", "West Bengal", "Andaman and Nicobar Islands", "Chandigarh", 
                    "Dadra and Nagar Haveli and Daman and Diu", "Delhi", "Jammu and Kashmir", 
                    "Ladakh", "Lakshadweep", "Puducherry"
                ];
                $scope.selectedOption = 'Select State';
                $scope.onStateChange = function () {
                    debugger;
                    var selecteState = $scope.selectedOption;
                    $scope.data.state = selecteState;
                }
                $scope.validateEmail = function (email) {
                const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
                return emailRegex.test(email);
                };
                
                $scope.saveleadData = function () {
                    debugger;
                    console.log('data == >'+$scope.data);
                    if (!$scope.validateEmail($scope.data.email)) {
                    swal('Invalid Email', 'Please enter a valid email address.', 'error');
                    return;
                }
                if($scope.data.firstName == undefined || $scope.data.firstName == ""){
                        swal('Required First Name', 'Please enter Firs tName.', 'error');
                        return;
                }
                if($scope.data.lastName == undefined || $scope.data.lastName == ""){
                        swal('Required Last Name', 'Please enter Last tName.', 'error');
                        return;
                }
                if($scope.data.email == undefined || $scope.data.email == ""){
                        swal('Required Email', 'Please enter Email.', 'error');
                        return;
                }
                var strinfydata = JSON.stringify($scope.data);
                ContactFormController.createContactRecord(strinfydata, function (result, event) {
                            if (result == 'SUCCESS' && event.status) {
                                swal('success', 'Details submitted successfully', 'success');
                                $scope.$apply();
                            } else {
                                alert("ERROR");
                            }
                        }
                    );
                };
                
                });
            </script>
            
            <div class="card">
                <div class="header">
                    <h3><b>Contact Details Information</b></h3>
                </div>
                
                <div class="container">
                    <div class="section-title">Basic Details</div>
                    
                    <!-- First Name and Last Name -->
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label class="form-label" for="firstName">First Name<span class="asterisk">*</span></label>
                            <input type="text" class="form-control" id="firstName" placeholder="Enter First Name" ng-model="data.firstName" />
                        </div>
                        <div class="col-md-6 form-group">
                            <label class="form-label" for="lastName">Last Name<span class="asterisk">*</span></label>
                            <input type="text" class="form-control" id="lastName" placeholder="Enter Last Name" ng-model="data.lastName" />
                        </div>
                    </div>
                    
                    <!-- Phone and Email -->
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label class="form-label" for="email">Email<span class="asterisk">*</span></label>
                            <input type="text" class="form-control" id="email" placeholder="Enter Email" ng-model="data.email" />
                        </div>
                          <div class="col-md-6 form-group">
                            <label class="form-label" for="phone">Phone</label>
                            <input type="text" class="form-control" id="phone" placeholder="Enter Phone" ng-model="data.phone" />
                        </div>
                    </div>
                    
                    <!-- State and City -->
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label class="form-label" for="state">State</label>
                            <select class="form-control" id="state" ng-model="selectedOption" ng-change="onStateChange()">
                                <option value="Select State" ><b>Select State</b></option>
                                <option ng-repeat="state in states" value="{{state}}">{{state}}</option>
                            </select>
                        </div>
                        <div class="col-md-6 form-group">
                            <label class="form-label" for="city">City</label>
                            <input type="text" class="form-control" id="city" placeholder="Enter City" ng-model="data.city" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label class="form-label" for="country">Country</label>
                            <input type="text" class="form-control" id="country" value="India"  ng-disabled="true" />
                        </div>
                        <div class="col-md-6 form-group">
                            <label class="form-label" for="pincode">Pincode</label>
                            <input type="text" class="form-control" id="pincode" placeholder="Enter Pincode" ng-model="data.pincode" />
                        </div>
                    </div>
                    <br/>
                    <!-- Submit Button -->
                    <div class="form-group text-center">
                        <button ng-click="saveleadData()" class="btn btn-primary">Submit</button>
                    </div>
                </div>
                
            </div>
        </body>
    </html>
</apex:page>